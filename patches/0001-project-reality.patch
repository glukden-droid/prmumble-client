+
+// Project Reality: keeps the shortcuts in the registry key of PRMumble 1.3
+// (HKCU\SOFTWARE\Project Reality\PR Mumble\shortcuts, QSettings array), because
+// the PR launcher reads it to show the transmit state in the game HUD and
+// writes its own key binds there. The launcher parses the values byte by byte,
+// so they are written exactly as Mumble 1.3 wrote them.
+
+#include "PRShortcuts.h"
+
+#include "GlobalShortcutTypes.h"
+#include "GlobalShortcut_win.h"
+#include "Settings.h"
+
+#include <QtCore/QBuffer>
+#include <QtCore/QDataStream>
+#include <QtCore/QSettings>
+
+#include "win.h"
+
+#include <string>
+
+namespace PRShortcuts {
+
+static const char *REG_PATH = "HKEY_CURRENT_USER\\SOFTWARE\\Project Reality\\PR Mumble";
+static const wchar_t *REG_KEY = L"SOFTWARE\\Project Reality\\PR Mumble\\shortcuts";
+
+// PR 1.3 shortcut index (launcher enum Actions) -> Mumble 1.5 shortcut type
+struct IndexType {
+	int prIndex;
+	int type;
+};
+static const IndexType INDEX_TYPES[] = {
+	{ 1, GlobalShortcutType::PushToTalk },  { 15, GlobalShortcutType::MuteSelf },
+	{ 16, GlobalShortcutType::DeafenSelf }, { 21, GlobalShortcutType::VolumeUp },
+	{ 22, GlobalShortcutType::VolumeDown },
+};
+
+// PR 1.3 whisper shortcuts: 2 = squad radio (current channel), 3 = all squad
+// leaders, 4..12 = squad leader 1..9, 13 = commander (parent channel + group)
+static const char *SL_GROUPS[] = { "bf2_squad_leader",        "bf2_first_squad_leader",  "bf2_second_squad_leader",
+								   "bf2_third_squad_leader",  "bf2_fourth_squad_leader", "bf2_fifth_squad_leader",
+								   "bf2_sixth_squad_leader",  "bf2_seventh_squad_leader", "bf2_eighth_squad_leader",
+								   "bf2_ninth_squad_leader", "bf2_commander" };
+static const int SQUAD_RADIO = 2;
+static const int SL_FIRST    = 3;
+static const int SL_LAST     = 13;
+
+static int typeOf(int prIndex) {
+	for (const IndexType &it : INDEX_TYPES) {
+		if (it.prIndex == prIndex) {
+			return it.type;
+		}
+	}
+	if (prIndex >= SQUAD_RADIO && prIndex <= SL_LAST) {
+		return GlobalShortcutType::Whisper_Shout;
+	}
+	return -1;
+}
+
+static ShortcutTarget defaultTarget(int prIndex) {
+	ShortcutTarget st;
+	st.bUsers       = false;
+	st.bForceCenter = true;
+	if (prIndex == SQUAD_RADIO) {
+		st.iChannel = -3;
+		st.qsGroup  = QString(QLatin1String(""));
+	} else {
+		st.iChannel  = -2;
+		st.qsGroup   = QLatin1String(SL_GROUPS[prIndex - SL_FIRST]);
+		st.bChildren = true;
+	}
+	return st;
+}
+
+static int prIndexOf(const Shortcut &s) {
+	if (s.iIndex == GlobalShortcutType::Whisper_Shout) {
+		if (!s.qvData.canConvert< ShortcutTarget >()) {
+			return -1;
+		}
+		const ShortcutTarget st = s.qvData.value< ShortcutTarget >();
+		if (st.bUsers || st.bCurrentSelection) {
+			return -1;
+		}
+		if (st.iChannel == -3 && st.qsGroup.isEmpty()) {
+			return SQUAD_RADIO;
+		}
+		if (st.iChannel == -2) {
+			for (int i = SL_FIRST; i <= SL_LAST; i++) {
+				if (st.qsGroup == QLatin1String(SL_GROUPS[i - SL_FIRST])) {
+					return i;
+				}
+			}
+		}
+		return -1;
+	}
+	for (const IndexType &it : INDEX_TYPES) {
+		if (it.type == s.iIndex) {
+			return it.prIndex;
+		}
+	}
+	return -1;
+}
+
+void load(Settings &settings) {
+	QSettings reg(QLatin1String(REG_PATH), QSettings::NativeFormat);
+	const int n = reg.beginReadArray(QLatin1String("shortcuts"));
+	QList< Shortcut > imported;
+	for (int i = 0; i < n; i++) {
+		reg.setArrayIndex(i);
+		Shortcut s;
+		const int prIndex = reg.value(QLatin1String("index"), -1).toInt();
+		s.iIndex          = typeOf(prIndex);
+		if (s.iIndex < 0) {
+			continue;
+		}
+		s.qlButtons = reg.value(QLatin1String("keys")).toList();
+		s.bSuppress = reg.value(QLatin1String("suppress"), false).toBool();
+		if (s.iIndex == GlobalShortcutType::Whisper_Shout) {
+			const QVariant data = reg.value(QLatin1String("data"));
+			s.qvData = data.canConvert< ShortcutTarget >() ? data : QVariant::fromValue(defaultTarget(prIndex));
+		} else if (s.iIndex == GlobalShortcutType::MuteSelf || s.iIndex == GlobalShortcutType::DeafenSelf) {
+			s.qvData = reg.value(QLatin1String("data"), 0).toInt();
+		}
+		imported << s;
+	}
+	reg.endArray();
+	if (imported.isEmpty()) {
+		return;
+	}
+	imported = GlobalShortcutWin::migrateSettings(imported);
+
+	// The registry is the source of truth for everything PR knows about
+	QList< Shortcut > merged;
+	for (const Shortcut &s : settings.qlShortcuts) {
+		if (prIndexOf(s) < 0) {
+			merged << s;
+		}
+	}
+	merged << imported;
+	settings.qlShortcuts = merged;
+}
+
+// QSettings stores a QVariant as "@Variant(" + QDataStream bytes as Latin-1 + ")";
+// with zero bytes in it the string goes to the registry as REG_BINARY UTF-16.
+static void writeVariantBytes(HKEY key, const wchar_t *name, const QByteArray &bytes) {
+	const QString str = QLatin1String("@Variant(") + QString::fromLatin1(bytes) + QLatin1String(")");
+	RegSetValueExW(key, name, 0, REG_BINARY, reinterpret_cast< const BYTE * >(str.utf16()),
+				   static_cast< DWORD >(str.size() * 2));
+}
+
+// Mumble 1.3 ShortcutTarget in a QVariant (no "v2" prefix, Qt_4_0 stream)
+static QByteArray legacyTarget(const ShortcutTarget &st) {
+	QByteArray bytes;
+	QDataStream ds(&bytes, QIODevice::WriteOnly);
+	ds.setVersion(QDataStream::Qt_4_0);
+	ds << quint32(127); // QVariant::UserType in Qt 4 streams
+	ds.writeBytes("ShortcutTarget", 15);
+	ds << st.bUsers << st.bForceCenter;
+	if (st.bUsers) {
+		ds << st.qlUsers;
+	} else {
+		// The launcher writes an empty (not null) group
+		const QString group = st.qsGroup.isNull() ? QString(QLatin1String("")) : st.qsGroup;
+		ds << st.iChannel << group << st.bLinks << st.bChildren;
+	}
+	return bytes;
+}
+
+void save(const Settings &settings) {
+	QList< QPair< int, Shortcut > > out;
+	for (const Shortcut &s : settings.qlShortcuts) {
+		const int prIndex = prIndexOf(s);
+		QList< QVariant > legacy;
+		if (prIndex > 0 && GlobalShortcutWin::toLegacyButtons(s.qlButtons, legacy)) {
+			Shortcut copy  = s;
+			copy.qlButtons = legacy;
+			out << qMakePair(prIndex, copy);
+		}
+	}
+
+	{
+		QSettings reg(QLatin1String(REG_PATH), QSettings::NativeFormat);
+		reg.remove(QLatin1String("shortcuts"));
+		reg.beginWriteArray(QLatin1String("shortcuts"), out.size());
+		for (int i = 0; i < out.size(); i++) {
+			const Shortcut &s = out.at(i).second;
+			reg.setArrayIndex(i);
+			reg.setValue(QLatin1String("index"), out.at(i).first);
+			reg.setValue(QLatin1String("keys"), s.qlButtons);
+			reg.setValue(QLatin1String("suppress"), s.bSuppress);
+			if (s.iIndex == GlobalShortcutType::Whisper_Shout) {
+				reg.setValue(QLatin1String("data"), 0); // replaced below
+			} else if (s.iIndex == GlobalShortcutType::MuteSelf || s.iIndex == GlobalShortcutType::DeafenSelf) {
+				reg.setValue(QLatin1String("data"), s.qvData.toInt());
+			} else {
+				reg.setValue(QLatin1String("data"), QVariant());
+			}
+		}
+		reg.endArray();
+		reg.sync();
+	}
+
+	HKEY root;
+	if (RegOpenKeyExW(HKEY_CURRENT_USER, REG_KEY, 0, KEY_SET_VALUE, &root) != ERROR_SUCCESS) {
+		return;
+	}
+	for (int i = 0; i < out.size(); i++) {
+		const Shortcut &s = out.at(i).second;
+		if (s.iIndex != GlobalShortcutType::Whisper_Shout) {
+			continue;
+		}
+		HKEY item;
+		const std::wstring sub = std::to_wstring(i + 1);
+		if (RegOpenKeyExW(root, sub.c_str(), 0, KEY_SET_VALUE, &item) == ERROR_SUCCESS) {
+			writeVariantBytes(item, L"data", legacyTarget(s.qvData.value< ShortcutTarget >()));
+			RegCloseKey(item);
+		}
+	}
+	RegCloseKey(root);
+}
+
+} // namespace PRShortcuts
