+bool GlobalShortcutWin::toLegacyButtons(const QList< QVariant > &buttons, QList< QVariant > &legacy) {
+	// Mumble 1.3 stored a DirectInput button as [uint (instance << 8) | DIDFT_PSHBUTTON, device GUID string]
+	const QString keyboard = QLatin1String("{6f1d2b61-d5a0-11cf-bfc7-444553540000}");
+	const QString mouse    = QLatin1String("{6f1d2b60-d5a0-11cf-bfc7-444553540000}");
+	constexpr unsigned int DIDFT_PSHBUTTON_ = 0x04;
+
+	legacy.clear();
+	for (const QVariant &button : buttons) {
+		if (button.userType() == qMetaTypeId< InputKeyboard >()) {
+			const InputKeyboard input = button.value< InputKeyboard >();
+			bool e0                   = input.e0;
+			if (input.code == 0x45) {
+				// See migrateSettings(): Pause / Numlock have the extended bit inverted
+				e0 = !e0;
+			}
+			const unsigned int value = (static_cast< unsigned int >(input.code) << 8) | (e0 ? 0x8000U : 0U)
+									   | DIDFT_PSHBUTTON_;
+			legacy << QVariant(QVariantList({ QVariant(value), QVariant(keyboard) }));
+		} else if (button.userType() == qMetaTypeId< InputMouse >()) {
+			const unsigned int value =
+				((static_cast< unsigned int >(button.value< InputMouse >()) + 2) << 8) | DIDFT_PSHBUTTON_;
+			legacy << QVariant(QVariantList({ QVariant(value), QVariant(mouse) }));
+		} else {
+			return false;
+		}
+	}
+	return true;
+}
