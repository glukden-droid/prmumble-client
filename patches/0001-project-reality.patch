diff --git a/src/mumble/PRReality.cpp b/src/mumble/PRReality.cpp
new file mode 100644
index 0000000..0674b15
--- /dev/null
+++ b/src/mumble/PRReality.cpp
@@ -0,0 +1,206 @@
+// Copyright The Mumble Developers. All rights reserved.
+// Use of this source code is governed by a BSD-style license
+// that can be found in the LICENSE file at the root of the
+// Mumble source tree or at <https://www.mumble.info/LICENSE>.
+
+// Project Reality: the data PRMumble 1.3 (class RealityData in mumble_app.dll)
+// gives the PR launcher for the in-game HUD "who is talking". Rebuilt from
+// mumble_app.dll; the launcher side is Reality.BF2.dll.
+//
+// Shared memory Local\PRMumbleSharedData<N> (the launcher tries N = 1..10),
+// 32 KiB, UTF-8 text, at most 32767 bytes, records joined by \x02, fields by \x01:
+//   name, channel, talk state, muted, deafened, x, y, z
+// - users: those in our channel and the channels linked to it, then the users
+//   who are talking (whisper/shout from elsewhere); we are always included,
+//   the others only when not muted, deafened, suppressed, locally muted or ignored;
+// - name: "name" of the plugin identity, else the user name;
+// - channel: name of the user's channel ("Commander", "Squad 3", ...);
+// - talk state: Settings::TalkState (0 passive, 1 talking, 2 whisper, 3 shout);
+// - muted: server mute, local mute or self mute; deafened: server or self deaf;
+// - x y z: the in-game position the user's PR client sent in UserState.position
+//   (field 20, the PR server relays it to the team only), no decimals.
+
+#include "PRReality.h"
+
+#include "Channel.h"
+#include "ClientUser.h"
+#include "Global.h"
+#include "ServerHandler.h"
+
+#include <QtCore/QTimer>
+
+#include "win.h"
+
+#include <cmath>
+#include <cstring>
+#include <string>
+
+namespace PRReality {
+
+static constexpr int SHM_SIZE = 32768;
+static constexpr int SHM_MAX  = 10;
+
+static HANDLE s_mapping = nullptr;
+static char *s_view     = nullptr;
+static QByteArray s_last;
+
+static Position3D s_sentPos;
+static bool s_resend = true;
+
+static bool openSharedMemory() {
+	if (s_view) {
+		return true;
+	}
+	for (int i = 1; i <= SHM_MAX; i++) {
+		const std::wstring name = L"Local\\PRMumbleSharedData" + std::to_wstring(i);
+		HANDLE h = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, SHM_SIZE, name.c_str());
+		if (!h) {
+			continue;
+		}
+		if (GetLastError() == ERROR_ALREADY_EXISTS) {
+			// Another PRMumble owns it
+			CloseHandle(h);
+			continue;
+		}
+		s_view = static_cast< char * >(MapViewOfFile(h, FILE_MAP_ALL_ACCESS, 0, 0, SHM_SIZE));
+		if (!s_view) {
+			CloseHandle(h);
+			break;
+		}
+		s_mapping = h;
+		std::memset(s_view, 0, SHM_SIZE);
+		return true;
+	}
+	qWarning("RealityData: Failed to create shared memory");
+	return false;
+}
+
+static bool shown(const ClientUser *u, const ClientUser *self) {
+	if (!u->cChannel) {
+		return false;
+	}
+	if (u == self) {
+		return true;
+	}
+	return !(u->bMute || u->bDeaf || u->bSuppress || u->bSelfMute || u->bSelfDeaf || u->bLocalMute
+			 || u->bLocalIgnore);
+}
+
+static QString record(const ClientUser *u) {
+	const QString name = u->qsPRName.isEmpty() ? u->qsName : u->qsPRName;
+	const bool muted   = u->bMute || u->bLocalMute || u->bSelfMute;
+	const bool deaf    = u->bDeaf || u->bSelfDeaf;
+	return QString::fromLatin1("%1\x01%2\x01%3\x01%4\x01%5\x01%6\x01%7\x01%8")
+		.arg(name)
+		.arg(u->cChannel->qsName)
+		.arg(static_cast< int >(u->tsState))
+		.arg(muted ? 1 : 0)
+		.arg(deaf ? 1 : 0)
+		.arg(static_cast< double >(u->fPRPosition[0]), 0, 'f', 0)
+		.arg(static_cast< double >(u->fPRPosition[1]), 0, 'f', 0)
+		.arg(static_cast< double >(u->fPRPosition[2]), 0, 'f', 0);
+}
+
+static QByteArray buildRecords() {
+	const ClientUser *self = ClientUser::get(Global::get().uiSession);
+	if (!self || !self->cChannel) {
+		return QByteArray();
+	}
+
+	QList< ClientUser * > users;
+	for (Channel *c : self->cChannel->allLinks()) {
+		for (User *u : c->qlUsers) {
+			users << static_cast< ClientUser * >(u);
+		}
+	}
+	for (ClientUser *u : ClientUser::getTalking()) {
+		if (!users.contains(u)) {
+			users << u;
+		}
+	}
+
+	QStringList records;
+	for (const ClientUser *u : users) {
+		if (shown(u, self) && !u->qsName.isEmpty()) {
+			records << record(u);
+		}
+	}
+	QByteArray out = records.join(QChar(0x02)).toUtf8();
+	if (out.size() > SHM_SIZE - 1) {
+		out.truncate(SHM_SIZE - 1);
+	}
+	return out;
+}
+
+void update() {
+	if (!openSharedMemory()) {
+		return;
+	}
+	const QByteArray data = Global::get().sh ? buildRecords() : QByteArray();
+	if (data == s_last) {
+		return;
+	}
+	std::memset(s_view, 0, SHM_SIZE);
+	std::memcpy(s_view, data.constData(), static_cast< size_t >(data.size()));
+	s_last = data;
+}
+
+void start(QObject *parent) {
+	QTimer *timer = new QTimer(parent);
+	QObject::connect(timer, &QTimer::timeout, &update);
+	timer->start(UPDATE_INTERVAL);
+}
+
+void setIdentity(ClientUser *user, const QString &identity) {
+	// As PRMumble 1.3: the text between "name":" and the next quote
+	const QString key = QLatin1String("\"name\":\"");
+	user->qsPRName.clear();
+	const int start = identity.indexOf(key);
+	if (start < 0) {
+		return;
+	}
+	const int from = start + key.size();
+	const int end  = identity.indexOf(QLatin1Char('"'), from + 1);
+	if (end < 0 || from >= end || from >= identity.size() || end >= identity.size()) {
+		return;
+	}
+	user->qsPRName = identity.mid(from, end - from);
+}
+
+void setPosition(ClientUser *user, const float *pos, int count) {
+	for (int i = 0; i < 3; i++) {
+		user->fPRPosition[i] = i < count ? pos[i] : 0.0f;
+	}
+}
+
+void sendPosition(const Position3D &pos, bool available) {
+	// As PRMumble 1.3 (Plugins::fetch): send when an axis moved more than
+	// POSITION_THRESHOLD since the last sent position; no game -> 0,0,0
+	const Position3D p = available ? pos : Position3D();
+	if (!s_resend && std::fabs(p.x - s_sentPos.x) <= POSITION_THRESHOLD && std::fabs(p.y - s_sentPos.y) <= POSITION_THRESHOLD
+		&& std::fabs(p.z - s_sentPos.z) <= POSITION_THRESHOLD) {
+		return;
+	}
+	s_sentPos = p;
+
+	if (ClientUser *self = ClientUser::get(Global::get().uiSession)) {
+		const float own[3] = { p.x, p.y, p.z };
+		setPosition(self, own, 3);
+	}
+	if (!Global::get().sh || !Global::get().uiSession) {
+		return;
+	}
+	s_resend = false;
+	MumbleProto::UserState mpus;
+	mpus.set_session(Global::get().uiSession);
+	mpus.add_position(p.x);
+	mpus.add_position(p.y);
+	mpus.add_position(p.z);
+	Global::get().sh->sendMessage(mpus);
+}
+
+void resetPosition() {
+	s_resend = true;
+}
+
+} // namespace PRReality
