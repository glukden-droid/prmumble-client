new file mode 100644
index 0000000..500f490
--- /dev/null
+++ b/src/mumble/PRReality.h
@@ -0,0 +1,37 @@
+// Copyright The Mumble Developers. All rights reserved.
+// Use of this source code is governed by a BSD-style license
+// that can be found in the LICENSE file at the root of the
+// Mumble source tree or at <https://www.mumble.info/LICENSE>.
+
+#ifndef MUMBLE_MUMBLE_PRREALITY_H_
+#define MUMBLE_MUMBLE_PRREALITY_H_
+
+#include "PositionalData.h"
+
+#include <QtCore/QString>
+
+class ClientUser;
+class QObject;
+
+/// Project Reality: in-game HUD data for the PR launcher (see PRReality.cpp).
+namespace PRReality {
+/// How often the HUD shared memory is refreshed, ms
+static constexpr int UPDATE_INTERVAL = 50;
+/// Own position is sent again when an axis changed more than this (as PRMumble 1.3)
+static constexpr float POSITION_THRESHOLD = 10.0f;
+
+/// Starts refreshing the HUD shared memory.
+void start(QObject *parent);
+/// Writes the HUD shared memory now.
+void update();
+/// Remembers the in-game name from a user's plugin identity (JSON "name").
+void setIdentity(ClientUser *user, const QString &identity);
+/// Remembers a user's in-game position from UserState.position.
+void setPosition(ClientUser *user, const float *pos, int count);
+/// Sends our in-game position (UserState.position) if it changed.
+void sendPosition(const Position3D &pos, bool available);
+/// Forgets the last sent position, so that it goes to a new server again.
+void resetPosition();
+} // namespace PRReality
+
+#endif
